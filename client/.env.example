# Public browser configuration only. Never put credentials in VITE_ variables.
# Serve the web app and API on the same origin in production.
# Vite proxies these paths to the local server during development.
VITE_API_URL=/api
# Public canonical origin used by runtime SEO metadata, e.g. https://tests.example.com
VITE_SITE_URL=https://your-domain.example
