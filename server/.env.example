PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/gate-test-series
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5000
TRUST_PROXY=false
# Production example:
# NODE_ENV=production
# CLIENT_ORIGIN=https://your-domain.example
# TRUST_PROXY=1  # only when exactly one verified reverse-proxy hop is used
# MONGO_URI=mongodb+srv://user:password@cluster.example.mongodb.net/gate-test-series
# JWT_SECRET=generate-a-new-random-secret-at-least-48-characters-long
# Verify the MongoDB provider allows the Hostinger server IP.
# On Render, allow the service's outbound IP ranges instead.
# Render's RENDER_EXTERNAL_URL is the default CLIENT_ORIGIN when none is set.
# For a custom domain, explicitly set CLIENT_ORIGIN to that HTTPS origin.
# QUESTION_MEDIA_DIR=/absolute/persistent/path/to/question-media
# GEMINI_API_KEY=optional-server-side-key-for-post-test-explanations
# GEMINI_MODEL=gemini-3.6-flash
